# Frontend
VITE_API_URL=https://seu-backend.onrender.com

# Backend
PORT=3000
NODE_ENV=production
FRONTEND_URL=https://seu-frontend.vercel.app
# Opcional: origens extras separadas por virgula. Util se voce tiver mais de um dominio Vercel/app.
CORS_ORIGINS=https://forge-flow-five.vercel.app,http://localhost,https://localhost,capacitor://localhost,http://localhost:5173
BACKEND_URL=https://seu-backend.onrender.com
MOBILE_REDIRECT_URL=forgeflow://auth/callback
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/forgeflow
JWT_SECRET=troque-por-um-segredo-grande
SESSION_SECRET=troque-por-outro-segredo-grande

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# E-mail para verificacao de conta e recuperacao de senha
# MAIL_PROVIDER pode ser smtp ou resend.
# Sem provedor configurado, os codigos aparecem apenas em desenvolvimento.
MAIL_PROVIDER=smtp
MAIL_FROM=ForgeFlow <noreply@seudominio.com>

# SMTP estilo Gmail, Outlook ou hospedagem propria
# Gmail: use uma senha de app, nao a senha normal da conta.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app

# Resend opcional, se preferir API
RESEND_API_KEY=

# COOKIE/CSRF
# Em producao com frontend/backend em dominios diferentes, use HTTPS para cookies SameSite=None; Secure.
