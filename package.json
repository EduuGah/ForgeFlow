{
  "name": "forgeflow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "import:exercisedb": "node scripts/importExerciseDb.js",
    "import:exercisedgifs": "node scripts/downloadExerciseGifs.js",
    "deps:audit": "node scripts/frontend-dependency-audit.mjs",
    "size:report": "node scripts/frontend-size-report.mjs",
    "check:frontend": "npm run lint:frontend && npm run build",
    "lint": "eslint src public scripts",
    "preview": "vite preview",
    "lint:frontend": "eslint src public scripts",
    "check:frontend:quick": "npm run deps:audit && npm run size:report",
    "check:server": "node scripts/run-project-checks.mjs check:server",
    "check:all": "npm run check:server && npm run build",
    "check": "npm run check:all",
    "test": "node scripts/run-tests.mjs",
    "test:frontend": "eslint src public scripts",
    "test:server": "node server/scripts/sanity-check.mjs && node server/scripts/workout-validation.test.mjs",
    "check:client": "npm run build",
    "postinstall": "node scripts/patch-capacitor-gradle.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@tailwindcss/vite": "^4.2.4",
    "lucide-react": "^1.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2",
    "recharts": "^3.8.1",
    "tailwindcss": "^4.2.4",
    "@capacitor/local-notifications": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "vite": "^8.0.10"
  }
}
