# Frontend
VITE_API_URL=https://seu-backend.onrender.com

# Backend
PORT=3000
NODE_ENV=production
FRONTEND_URL=https://seu-frontend.vercel.app
BACKEND_URL=https://seu-backend.onrender.com
MOBILE_REDIRECT_URL=forgeflow://auth/callback
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/forgeflow
# Segredos de assinatura. O servidor se recusa a subir com valores fracos:
# minimo de 32 caracteres E 12 caracteres distintos.
# Gere cada um rodando (dentro de server/):  npm run gen:secret
# Em producao defina os dois no painel do Render, nao neste arquivo.
JWT_SECRET=troque-rodando-npm-run-gen-secret
SESSION_SECRET=troque-rodando-npm-run-gen-secret

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# E-mail opcional para recuperação de senha pública
# Sem essas variáveis, o endpoint existe, mas não envia e-mail em produção.
RESEND_API_KEY=
MAIL_FROM=ForgeFlow <noreply@seudominio.com>

# COOKIE/CSRF
# Em produção com frontend/backend em domínios diferentes, use HTTPS para cookies SameSite=None; Secure.
