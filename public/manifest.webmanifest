{
  "name": "ForgeFlow",
  "short_name": "ForgeFlow",
  "description": "ForgeFlow é um app de treinos para registrar cargas, acompanhar evolução, metas e histórico.",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "theme_color": "#0b0b0f",
  "background_color": "#000000",
  "categories": [
    "health",
    "fitness",
    "sports",
    "productivity"
  ],
  "lang": "pt-BR",
  "dir": "ltr",
  "icons": [
    {
      "src": "/icons/pwa-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/pwa-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/pwa-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/pwa-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Meus treinos",
      "short_name": "Treinos",
      "description": "Abrir rotinas de treino",
      "url": "/workouts?source=pwa-shortcut",
      "icons": [
        {
          "src": "/icons/pwa-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Treino ativo",
      "short_name": "Treino",
      "description": "Abrir treino ativo",
      "url": "/start-workout?source=pwa-shortcut",
      "icons": [
        {
          "src": "/icons/pwa-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Exercícios",
      "short_name": "Exercícios",
      "description": "Abrir biblioteca de exercícios",
      "url": "/exercises?source=pwa-shortcut",
