  "shortcuts": [
    {
      "name": "Iniciar treino",
      "short_name": "Treinar",
      "description": "Abrir a página de treinos.",
      "url": "/workouts?source=pwa-shortcut",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Ver evolução",
      "short_name": "Evolução",
      "description": "Abrir a página de evolução.",
      "url": "/progress?source=pwa-shortcut",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Metas",
      "short_name": "Metas",
      "description": "Abrir suas metas.",
      "url": "/goals?source=pwa-shortcut",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
