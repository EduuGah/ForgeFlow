{
  "name": "ForgeFlow",
  "short_name": "ForgeFlow",
  "description": "App de treinos para registrar cargas, acompanhar evolução, metas, PRs e histórico.",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait",
  "background_color": "#0b0b0f",
  "theme_color": "#0b0b0f",
  "categories": ["health", "fitness", "productivity"],
  "lang": "pt-BR",
  "dir": "ltr",
  "icons": [
